				g_iStats[ i ][ STAT_POINTS ] += 10
			}
			else if (team == CS_TEAM_CT)
			{
				g_iStats[ i ][ STAT_LOS ] += 1
				bps_players_versus[ i ] = 0
			}
			FlushPlayerStats( i, true )
		}
