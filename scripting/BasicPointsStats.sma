{
	#pragma unused _pug_fw_id
	g_bPugForwardLive = false
	g_bWasLiveTracking = false
	return PLUGIN_CONTINUE
}

public pug_secondhalf(const _pug_fw_id[BPS_PUG_FORW_LEN])
{
	#pragma unused _pug_fw_id
	g_bPugForwardLive = true
	return PLUGIN_CONTINUE
